# Settings for deploy/docker-compose.remote-worker.yml, on the worker machine. Copy to .env.remote-worker.
# The secrets must match the main server's .env.

# The main server's LAN address (a fixed one: reserve it in your router).
MAIN_SERVER=192.168.1.10

POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Which queues this worker serves (comma separated) and how many jobs at once.
# mapping = photo mapping + object recognition. A queue should be served by one machine.
WORKER_QUEUES=mapping
WORKER_CONCURRENCY=1

# Which PyTorch ./build-remote-worker.sh builds into the image: cpu (no GPU), cu126 (NVIDIA) or rocm7.1 (AMD).
TORCH_INDEX=cpu
# auto uses the GPU if there is one; set cuda to refuse to start without it (recommended once it works).
TORCH_DEVICE=auto

# AMD only: your host's `render` group id (getent group render), and the gfx override for cards that
# ROCm does not officially list (see docker-compose.gpu-worker.amd.yml).
# RENDER_GID=991
# HSA_OVERRIDE_GFX_VERSION=10.3.0
