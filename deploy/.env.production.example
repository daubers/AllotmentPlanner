# Settings for deploy/docker-compose.prod.yml. Copy to deploy/.env and edit.

# --- Where the images come from (built and pushed by the CI `build` workflow) ---------------------
# pkgs.daubney.dev/allotment. Images: allotment-api, allotment-frontend, allotment-worker.
REGISTRY=pkgs.daubney.dev/allotment
# latest follows the main branch. Pin a release (e.g. 0.3.0) or a commit (sha-1a2b3c4) for stability.
TAG=latest
# The one port the web app and API are served on (put a TLS reverse proxy in front of it).
HTTP_PORT=8080

# --- Secrets: generate each with `openssl rand -hex 32` -------------------------------------------
POSTGRES_PASSWORD=change-me
JWT_SECRET_KEY=change-me-to-a-long-random-value
# Encrypts the stored Mastodon tokens. Keep it separate from JWT_SECRET_KEY, and do not lose it:
# without it the stored tokens cannot be read (you would reconnect Mastodon).
TOKEN_ENCRYPTION_KEY=change-me-to-another-long-random-value

# --- Who can sign up -------------------------------------------------------------------------------
# invite (default here): the first account on an empty server, then only people an allotment owner has
# invited. open: anyone who can reach the server can register.
REGISTRATION=invite
# How long an invite link stays valid.
# INVITE_TTL_DAYS=7

# --- Single sign-on (OpenID Connect) ----------------------------------------------------------------
# Optional. Adds "Sign in with ..." buttons beside the password login, on the web and in the phone app.
# People still need an account or an invite: signing in with a provider never creates one by itself.
# See docs/oidc.md. One JSON list on one line; a preset needs only client_id and client_secret:
# OIDC_PROVIDERS=[{"id":"authentik","name":"Authentik","issuer":"https://auth.example.com/application/o/allotment/","client_id":"...","client_secret":"..."},{"preset":"google","client_id":"...","client_secret":"..."}]
# The address people reach the site at. Redirect URIs are built from it, so set it when you use the above.
# PUBLIC_URL=https://plot.example.com
# Where the phone app may be sent back to after signing in (comma separated). The default is its own link.
# OIDC_MOBILE_REDIRECTS=allotment://auth

# --- Optional ------------------------------------------------------------------------------------
# Largest accepted upload in MB (a GoPro chapter is about 4 GB). nginx in the frontend image allows
# 4 GB; if you raise this, also raise client_max_body_size in frontend/nginx.conf and rebuild.
# MAX_UPLOAD_MB=4096
# LOG_LEVEL=INFO

# Store photos in S3-compatible storage instead of the `media` volume:
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://...
# S3_BUCKET=allotment-media
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...

# Photo mapping (only with `--profile mapping`):
# MAPPING_MAX_IMAGES=150
# MAPPING_MAX_FRAMES_PER_VIDEO=60
# MAPPING_TIMEOUT_SECONDS=7200
# MAPPING_DETECT_MAX_SHOTS=40
# MAPPING_DETECT_MAX_RANGE_M=15

# Mastodon timing: seconds a burst of photos is held to make one post, and the UTC hour of the digest.
# MASTODON_PHOTO_BATCH_SECONDS=180
# MASTODON_DIGEST_HOUR_UTC=19

# --- A worker on another machine (docker-compose.lan.yml, README "GPU worker") ---------------------
# LAN_IP=192.168.1.10
# REDIS_PASSWORD=change-me
# REDIS_URL=redis://:change-me@redis:6379/0
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://s3:9000
# S3_BUCKET=allotment-media
# S3_ACCESS_KEY=allotment
# S3_SECRET_KEY=change-me-at-least-8-chars
