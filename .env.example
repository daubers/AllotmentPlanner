DATABASE_URL=postgresql+psycopg://allotment:allotment@db:5432/allotment
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
# Uncomment with `--profile observability` to export traces to Jaeger
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
FLASK_APP=allotment:create_app
# Required in production; must be 32+ random bytes
JWT_SECRET_KEY=dev-only-insecure-secret-change-me-in-prod
# Media storage: 'file' (shared volume, default) or 's3' (any S3-compatible service)
STORAGE_BACKEND=file
MEDIA_ROOT=/data/media
# For STORAGE_BACKEND=s3:
# S3_ENDPOINT_URL=https://...
# S3_BUCKET=allotment-media
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
