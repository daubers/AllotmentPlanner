DATABASE_URL=postgresql+psycopg://allotment:allotment@db:5432/allotment
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
# Uncomment with `--profile observability` to export traces to Jaeger
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
FLASK_APP=allotment:create_app
# Required in production; must be 32+ random bytes
JWT_SECRET_KEY=dev-only-insecure-secret-change-me-in-prod
# Encrypts stored Mastodon tokens. Unset = derived from JWT_SECRET_KEY; set it in production so
# rotating the JWT secret doesn't make stored tokens unreadable.
# TOKEN_ENCRYPTION_KEY=
# Mastodon: only for testing against a local instance (allows http and private addresses).
# FEDIVERSE_ALLOW_PRIVATE_HOSTS=1
# Seconds to wait so a burst of photo uploads becomes one post; UTC hour of the daily digest.
# MASTODON_PHOTO_BATCH_SECONDS=180
# MASTODON_DIGEST_HOUR_UTC=19
# Media storage: 'file' (shared volume, default) or 's3' (any S3-compatible service)
STORAGE_BACKEND=file
MEDIA_ROOT=/data/media
# For STORAGE_BACKEND=s3:
# S3_ENDPOINT_URL=https://...
# S3_BUCKET=allotment-media
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# Map from photos (run by the `mapper` service: `make mapper`). Limits per map build:
# MAPPING_MAX_IMAGES=150
# MAPPING_MAX_FRAMES_PER_VIDEO=60
# MAPPING_VIDEO_FPS=1
# MAPPING_TIMEOUT_SECONDS=7200
# Largest accepted upload in MB (default 4096: enough for a GoPro chapter). If you raise it, raise
# `client_max_body_size` in frontend/nginx.conf to match.
# MAX_UPLOAD_MB=4096
