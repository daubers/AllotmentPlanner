{
  "expo": {
    "name": "Allotment",
    "slug": "allotment-field",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.daubney.allotment",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        },
        "NSMotionUsageDescription": "Allotment checks how level the camera is held."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F1F4EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.daubney.allotment"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {}
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allotment uses the camera to take photos of your plot."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allotment records where each photo was taken so it can build a map of your plot."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allotment lets you choose photos of your plot from your library."
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F1F4EE"
        }
      ]
    ],
    "scheme": "allotment",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    }
  }
}
